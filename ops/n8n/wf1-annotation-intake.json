{
  "name": "WF1 — Annotation Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "annotation-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-intake",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "annotation-intake"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json;\nconst slug = body.slug || '';\nconst selector = body?.target?.selector || {};\nconst exact = selector.exact || selector.value || '';\nconst comment = Array.isArray(body.body)\n  ? body.body.map(b => b.value).join(' ')\n  : '';\nconst creator = body['dc:creator'] || body?.creator?.name || 'anonymous';\nreturn [{ json: { slug, exact, comment, creator, raw: JSON.stringify(body) } }];"
      },
      "id": "normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "getAll",
        "owner": "={{ $vars.GITHUB_REPO_OWNER }}",
        "repository": "={{ $vars.GITHUB_REPO_NAME }}",
        "filters": {
          "labels": "article-feedback,slug:={{ $json.slug }}"
        },
        "returnAll": false,
        "limit": 5
      },
      "id": "search-issues",
      "name": "Search existing issues",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ]
        }
      },
      "id": "is-new-issue",
      "name": "New or existing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "create",
        "owner": "={{ $vars.GITHUB_REPO_OWNER }}",
        "repository": "={{ $vars.GITHUB_REPO_NAME }}",
        "title": "=Feedback: {{ $('Normalize').item.json.slug }} — {{ $('Normalize').item.json.comment.slice(0,60) }}",
        "body": "=## SME feedback annotation\n\n**Article:** {{ $('Normalize').item.json.slug }}\n**Reviewer:** {{ $('Normalize').item.json.creator }}\n\n> {{ $('Normalize').item.json.exact }}\n\n{{ $('Normalize').item.json.comment }}\n\n```json\n{{ $('Normalize').item.json.raw }}\n```",
        "labels": ["article-feedback", "status:new"]
      },
      "id": "create-issue",
      "name": "Create issue",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "issue",
        "operation": "createComment",
        "owner": "={{ $vars.GITHUB_REPO_OWNER }}",
        "repository": "={{ $vars.GITHUB_REPO_NAME }}",
        "issueNumber": "={{ $json[0].number }}",
        "body": "=+1 / additional note from {{ $('Normalize').item.json.creator }}:\n\n> {{ $('Normalize').item.json.exact }}\n\n{{ $('Normalize').item.json.comment }}"
      },
      "id": "add-comment",
      "name": "Add comment to existing",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "value": "={{ $vars.SLACK_CHANNEL_ID }}" },
        "text": "=:memo: New article feedback\n*Article:* {{ $('Normalize').item.json.slug }}\n*By:* {{ $('Normalize').item.json.creator }}\n*Quote:* {{ $('Normalize').item.json.exact.slice(0,100) }}\n*Comment:* {{ $('Normalize').item.json.comment.slice(0,200) }}"
      },
      "id": "slack-ping",
      "name": "Slack ping",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]] },
    "Normalize": { "main": [[{ "node": "Search existing issues", "type": "main", "index": 0 }]] },
    "Search existing issues": { "main": [[{ "node": "New or existing?", "type": "main", "index": 0 }]] },
    "New or existing?": {
      "main": [
        [{ "node": "Create issue", "type": "main", "index": 0 }],
        [{ "node": "Add comment to existing", "type": "main", "index": 0 }]
      ]
    },
    "Create issue": { "main": [[{ "node": "Slack ping", "type": "main", "index": 0 }]] },
    "Add comment to existing": { "main": [[{ "node": "Slack ping", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{"name": "ghostwriter"}],
  "triggerCount": 0,
  "versionId": "ghostwriter-v1"
}
