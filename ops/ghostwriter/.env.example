# Local Ghostwriter dev (copy to .env.local)
#
# Same-origin via Vite proxy (recommended — iframe + localStorage share origin):
#   Leave VITE_API_BASE unset or comment it out, then:
#     python ops/ghostwriter/dev_server.py   # :8767
#     cd ops/ghostwriter && npm run dev      # :5173 proxies /api and /static
#
# Direct shim (iframe on :8767, separate from SPA):
# VITE_API_BASE=http://127.0.0.1:8767

# Production / VM (default when .env.local is absent)
# VITE_API_BASE=http://18.192.122.48

# n8n annotation webhook (Feedback view — optional locally)
# VITE_N8N_WEBHOOK=http://18.192.122.48/n8n/webhook/annotation-intake
